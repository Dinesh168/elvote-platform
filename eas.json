{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "demo": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "demo",
        "EXPO_PUBLIC_API_URL": "https://demo.champn.in/api",
        "EXPO_PUBLIC_AUTH_MODE": "firebase"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
