{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "demo": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "demo",
        "EXPO_PUBLIC_API_URL": "https://demo.champn.in/api",
        "EXPO_PUBLIC_AUTH_MODE": "firebase",
        "EAS_PROJECT_ID": "cf30fc3e-caf9-4362-9cf6-9ff710cb5afb"
      },
      "channel": "demo",
      "node": "24.13.1"
    },
    "demo-store": {
      "extends": "demo",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {},
    "demo-store": {
      "ios": {}
    }
  }
}
