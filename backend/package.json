{
  "name": "node-project",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/main",
    "run_next_migration": "knex migrate:up --migrations-directory src/models/migrations",
    "undo_last_migration": "knex migrate:down --migrations-directory src/models/migrations",
    "create_migration": "knex migrate:make --migrations-directory src/models/migrations"
  },
  "dependencies": {
    "assert": "^2.0.0",
    "axios": "^1.6.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "~4.16.1",
    "express-fileupload": "^1.4.0",
    "express-jwt": "^8.3.0",
    "firebase-admin": "^12.1.0",
    "form-data": "^4.0.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^8.5.1",
    "jwks-rsa": "^3.0.1",
    "knex": "^2.5.1",
    "mime": "^3.0.0",
    "node-tesseract-ocr": "^2.2.1",
    "node-xlsx": "^0.24.0",
    "pg": "^8.11.5",
    "swagger-autogen": "^2.23.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.5.0"
  },
  "engines": {
