{
  "name": "elvote-backend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "tsx scripts/db-server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^16.10.0-beta.15",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
