{
  "expo": {
    "name": "elvote-max",
    "slug": "elvote-max",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.akamit.elvotemax"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "icon": "./assets/brand/icon.png",
      "themeColor": "#184BA1"
    },
    "extra": {
      "eas": {
        "projectId": "ab4733a5-f49e-4a7b-9f16-bfa95ffaa649"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ElVote uses your location to put your booth on the map and, on polling day, to show your team that you are at your booth.",
          "locationAlwaysAndWhenInUsePermission": "On polling day, during voting hours only, ElVote checks that you are at your booth so your team knows, even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#1B5E20"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-vertical.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
